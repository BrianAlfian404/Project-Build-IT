#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int N;
    scanf("%d", &N);
    for(int i = 1; i <= 10; i++){
        printf("%d x %d = %d\n",N, i, N*i);
    }
        
    
    

